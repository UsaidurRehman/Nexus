# ---------------------------------------------------------------------------
# Nexus Web Portal — environment
# Every value here is consumed ONLY by src/config.js. Nothing else reads import.meta.env.
# ---------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API. Leave as-is for same-origin deploys.
VITE_API_BASE_URL=https://localhost:7001

# Master switch for the offline mock layer. Defaults to FALSE: the real
# ASP.NET Core API is now the source of truth. Set to true only for UI work
# without a running backend.
# true  -> read-only api.* functions resolve from src/mocks/fixtures.js
# false -> real HTTP calls through axios (admin panel REQUIRES this)
VITE_USE_MOCK_API=false

# Simulated network latency (ms) while in mock mode.
VITE_MOCK_LATENCY_MS=450

# Prefix for relative image paths returned by the API (e.g. "/uploads/x.jpg").
# Leave blank to fall back to VITE_API_BASE_URL.
VITE_ASSET_BASE_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Deploy under a subfolder? e.g. /nexus/   (must match vite `base`)
VITE_PUBLIC_BASE=/

# Canonical site origin, used for SEO/OpenGraph absolute URLs.
VITE_SITE_URL=https://nexus.biit.edu.pk

# ---------------------------------------------------------------------------
# Registration
# ---------------------------------------------------------------------------
# Where the "Register" button sends people ONCE registration opens
# (1 November 2026, 00:00 PKT — set in REGISTRATION.OPENS_AT in config.js).
# Leave BLANK until the real form exists: the button then keeps showing the
# "coming soon" dialog instead of rendering a dead link.
VITE_REGISTRATION_URL=

# Official Nexus booklet (Canva). Must be a /view link, not /edit, or visitors
# without edit rights hit a permission wall.
VITE_BOOKLET_URL=https://www.canva.com/design/DAHW9UMXS90/SY61va_kjPo_gyZiHoD30Q/view
